# ====== SERVER ======
PORT=5000

# ====== SUPABASE (Project Settings > API) ======
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key

# ====== EMAIL - SMTP (Gmail: dùng App Password) ======
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ====== EMAIL - RESEND (ưu tiên cho email đơn hàng) ======
RESEND_API_KEY=your_resend_api_key
MY_EMAIL=admin@yourdomain.com

# ====== SHIPPING - GHN (Giao Hàng Nhanh) ======
GHN_API_TOKEN=your_ghn_token
GHN_SHOP_ID=your_ghn_shop_id
GHN_API_URL=https://online-gateway.ghn.vn/shiip/public-api

# ====== CLOUDINARY (lưu trữ ảnh) ======
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
